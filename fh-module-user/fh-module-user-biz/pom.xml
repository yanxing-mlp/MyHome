<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.familyhome</groupId>
    <artifactId>fh-module-user</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>fh-module-user-biz</artifactId>
  <name>fh-module-user-biz</name>
  <description>
    账号域实现：全家成员（昵称 + 手机号 + 头像）的登录校验与增删改查。
    依赖 file-api 只为把 avatar_file_id 换成可访问 URL，与相册/菜谱换封面 URL 是同一条路。
  </description>

  <dependencies>
    <dependency>
      <groupId>com.familyhome</groupId>
      <artifactId>fh-module-user-api</artifactId>
    </dependency>
    <!-- 跨域依赖：只允许依赖对方 -api，禁止依赖 file-biz -->
    <dependency>
      <groupId>com.familyhome</groupId>
      <artifactId>fh-module-file-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
  </dependencies>
</project>
